{
  "name": "opencode-reviewer",
  "version": "2.5.3",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Safety reviews, report history, optional one-time auto-approval and Linux desktop notifications for OpenCode permissions",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mightykatun/opencode-reviewer.git"
  },
  "homepage": "https://github.com/mightykatun/opencode-reviewer#readme",
  "bugs": {
    "url": "https://github.com/mightykatun/opencode-reviewer/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "permissions",
    "auto-approval"
  ],
  "exports": {
    ".": "./dist/tui.js",
    "./server": "./dist/tui.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist/tui.js",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22",
    "opencode": ">=2.0.0 <3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.22.2 || ^24.15.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-source.mjs",
    "test:helpers": "node scripts/test-helpers.mjs",
    "test:runtime-cleanup": "node --test test/smoke-runtime.test.mjs",
    "test:runtime-permissions": "node scripts/test-runtime.mjs --profile v2-permissions",
    "test:runtime": "node scripts/test-runtime.mjs --profile v2-acceptance",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm run typecheck && npm test && npm run test:helpers && npm run build"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.28.5",
    "@opencode/client": "^2.0.0",
    "@opencode/plugin": "^2.0.0",
    "@opencode/theme": "^2.0.0",
    "@opentui/core": "0.6.8",
    "@opentui/keymap": "0.6.8",
    "@opentui/solid": "0.6.8",
    "@types/node": "24.12.2",
    "babel-preset-solid": "1.9.10",
    "esbuild": "0.28.2",
    "mpg123-decoder": "1.0.3",
    "shell-quote": "1.12.0",
    "solid-js": "1.9.15",
    "string-width": "7.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@babel/core": "$@babel/core",
    "@opentui/solid": {
      "solid-js": "$solid-js"
    },
    "@opentui/keymap": {
      "solid-js": "$solid-js"
    },
    "seroval": "1.6.3"
  }
}
